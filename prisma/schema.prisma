generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  CANCELED
}

enum PaymentProvider {
  SIMULATED
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  SIMULATED
  PIX
  CREDIT_CARD
}

enum ShippingMethod {
  PADRAO
  EXPRESSA
  ANJUN_D2D_PICKUP
  RETIRADA_LOCAL
}

enum LaunchReadinessStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ProductAnalyticsEventType {
  PRODUCT_VIEW
  ADD_TO_CART
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  whatsapp       String
  whatsappDigits String   @unique
  source         String   @default("WHATSAPP_LIGHT_LOGIN")
  loginCount     Int      @default(0)
  firstSeenAt    DateTime @default(now())
  lastLoginAt    DateTime?
  lastSeenAt     DateTime?
  orders         Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lastSeenAt])
}

model Brand {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String    @unique
  logo          String
  origin        String
  descriptionPt String
  featured      Boolean   @default(false)
  categorySlugs String[]
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Category {
  id            String               @id @default(cuid())
  slug          String               @unique
  label         String
  note          String
  products      Product[]
  subcategories ProductSubcategory[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model ProductSubcategory {
  id        String    @id @default(cuid())
  categoryId String
  slug      String
  label     String
  sortOrder Int       @default(0)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
}

model Product {
  id                  String      @id @default(cuid())
  slug                String      @unique
  brandId             String
  categoryId          String
  subcategoryId       String?
  name                String
  subcategory         String
  priceCents          Int
  basePriceCents      Int?
  baseBoxPriceCents   Int?
  baseBoxPieces       Int?
  compareAtPriceCents Int?
  weightGrams         Int?
  suggestedQuantity   Int?
  kitRecommendation   String?
  wholesalePackage    String?
  validityNote        String?
  purchaseNote        String?
  image               String
  trayImage           String?
  gallery             String[]
  descriptionPt       String
  benefits            String[]
  ingredients         String[]
  skinType            String
  finish              String
  volume              String
  gtin                String?
  mpn                 String?
  rating              Float
  reviewCount         Int
  stockStatus         String
  badges              String[]
  active              Boolean     @default(true)
  deletedAt           DateTime?
  deletedByAdminEmail String?
  deleteNote          String?
  featuredRank        Int         @default(0)
  brand               Brand       @relation(fields: [brandId], references: [id])
  category            Category    @relation(fields: [categoryId], references: [id])
  subcategoryOption   ProductSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  inventory           Inventory?
  skus                ProductSku[]
  orderItems          OrderItem[]
  analyticsEvents     ProductAnalyticsEvent[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([categoryId, active])
  @@index([subcategoryId])
  @@index([brandId, active])
  @@index([deletedAt])
  @@index([active, deletedAt])
  @@index([gtin])
  @@index([mpn])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  quantity  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

model ProductSku {
  id         String      @id @default(cuid())
  productId  String
  name       String
  code       String
  image      String?
  priceCents Int?
  basePriceCents Int?
  quantity   Int         @default(0)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  analyticsEvents ProductAnalyticsEvent[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([productId, code])
  @@index([productId, active, sortOrder])
}

model ProductAnalyticsEvent {
  id             String                    @id @default(cuid())
  eventType      ProductAnalyticsEventType
  eventDate      DateTime                  @db.Date
  dedupeKey      String?                   @unique
  anonymousId    String
  productId      String
  productSkuId   String?
  productSlug    String
  productSkuCode String?
  quantity       Int                       @default(1)
  product        Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productSku     ProductSku?               @relation(fields: [productSkuId], references: [id], onDelete: SetNull)
  createdAt      DateTime                  @default(now())

  @@index([eventType, eventDate])
  @@index([productId, eventType, eventDate])
  @@index([productSkuId, eventType, eventDate])
  @@index([productSlug, eventDate])
}

model Order {
  id                      String         @id @default(cuid())
  customerId              String?
  orderNumber             String         @unique
  status                  OrderStatus    @default(PENDING_PAYMENT)
  customerName            String
  customerEmail           String
  customerPhone           String
  customerCpf             String
  cep                     String
  state                   String
  city                    String
  district                String
  street                  String
  number                  String
  complement              String?
  addressMatchStatus      String         @default("NOT_CHECKED")
  addressMatchProvider    String?
  addressMatchFormatted   String?
  addressMatchPlaceId     String?
  addressMatchGranularity String?
  addressLatitude         Float?
  addressLongitude        Float?
  addressMatchMessage     String?
  addressMatchCheckedAt   DateTime?
  shippingMethod          ShippingMethod @default(PADRAO)
  shippingCarrier         String?
  shippingService         String?
  shippingServiceLabel    String?
  shippingRateId          String?
  shippingZone            String?
  shippingCity            String?
  shippingWeightGrams     Int            @default(0)
  shippingEstimate        String?
  shippingQuoteStatus     String         @default("NOT_QUOTED")
  shippingQuoteMessage    String?
  shippingQuoteSnapshot   Json?
  subtotalCents           Int
  discountCents           Int
  shippingCents           Int
  totalCents              Int
  gclid                   String?
  gbraid                  String?
  wbraid                  String?
  utmSource               String?
  utmMedium               String?
  utmCampaign             String?
  utmTerm                 String?
  utmContent              String?
  customer                Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  payment                 Payment?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([customerId])
  @@index([addressMatchStatus])
  @@index([gclid])
}

model ShippingRateImport {
  id            String         @id @default(cuid())
  carrier       String
  service       String
  sourceName    String
  sourceSheet   String
  originKey     String
  originLabel   String
  versionLabel  String
  effectiveFrom DateTime?
  rowCount      Int
  stateCount    Int
  zoneCount     Int
  active        Boolean        @default(false)
  rates         ShippingRate[]
  createdAt     DateTime       @default(now())

  @@index([carrier, service, originKey, active])
}

model ShippingRate {
  id                String             @id @default(cuid())
  importId          String
  carrier           String
  service           String
  originKey         String
  originLabel       String
  destinationState  String
  city              String
  cepStart          Int
  cepEnd            Int
  zone              String
  ratesCents        Int[]
  additionalKgCents Int
  active            Boolean            @default(true)
  import            ShippingRateImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())

  @@index([active, carrier, service, originKey])
  @@index([destinationState, cepStart, cepEnd])
  @@index([importId])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String?
  productSkuId   String?
  productSlug    String
  productName    String
  productBrand   String
  productImage   String
  productSkuName String?
  productSkuCode String?
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSku     ProductSku? @relation(fields: [productSkuId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productSkuId])
}

model Payment {
  id                        String          @id @default(cuid())
  orderId                   String          @unique
  provider                  PaymentProvider @default(SIMULATED)
  method                    PaymentMethod   @default(SIMULATED)
  status                    PaymentStatus   @default(PENDING)
  amountCents               Int
  paidAt                    DateTime?
  providerPreferenceId      String?         @unique
  providerPaymentId         String?         @unique
  providerExternalReference String?
  providerInitPoint         String?
  providerSandboxInitPoint  String?
  providerStatus            String?
  providerStatusDetail      String?
  providerPayload           Json?
  syncError                 String?
  lastWebhookAt             DateTime?
  order                     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
}

model PaymentWebhookEvent {
  id             String          @id @default(cuid())
  provider       PaymentProvider @default(MERCADO_PAGO)
  dedupeKey      String          @unique
  providerEventId String?
  requestId      String?
  dataId         String?
  eventType      String?
  action         String?
  signatureValid Boolean         @default(false)
  payload        Json
  processedAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([provider, dataId])
  @@index([provider, requestId])
}

model PriceAdjustmentJob {
  id                  String    @id @default(cuid())
  status              String    @default("PENDING")
  direction           String
  type                String
  value               Int
  totalProducts       Int       @default(0)
  processedProducts   Int       @default(0)
  adjustedProducts    Int       @default(0)
  adjustedSkus        Int       @default(0)
  skippedProducts     Int       @default(0)
  skippedSkus         Int       @default(0)
  descriptionWarnings Int       @default(0)
  error               String?
  createdByAdminEmail String?
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
}

model LaunchReadinessItem {
  id          String                @id @default(cuid())
  itemKey     String                @unique
  group       String
  title       String
  description String
  status      LaunchReadinessStatus @default(PENDING)
  priority    Int                   @default(2)
  notes       String                @default("")
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([group, sortOrder])
  @@index([status, priority])
}

model SiteInfoPage {
  id          String   @id @default(cuid())
  pageKey     String   @unique
  slug        String   @unique
  href        String   @unique
  eyebrow     String
  title       String
  description String
  sections    Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, slug])
}

model GuideArticle {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String
  coverImage    String?
  coverImageAlt String?
  body          String
  authorName    String?
  reviewerName  String?
  reviewedAt    DateTime?
  sourceNotes   String?
  active        Boolean   @default(false)
  publishedAt   DateTime?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active, publishedAt])
  @@index([sortOrder])
}

model StoreProfile {
  id                String   @id @default("main")
  storeName         String   @default("RosaGiro")
  legalName         String   @default("")
  cnpj              String   @default("00.000.000/0000-00")
  stateRegistration String   @default("Isento ou a ajustar")
  cep               String   @default("00000-000")
  state             String   @default("SP")
  city              String   @default("São Paulo")
  district          String   @default("A ajustar")
  street            String   @default("Endereço em preparação")
  number            String   @default("S/N")
  complement        String?
  email             String   @default("rosagiroatacado@gmail.com")
  whatsapp          String   @default("+55 11 97079-2390")
  businessHours     String   @default("Segunda a sexta, 9h às 18h")
  instagramUrl      String   @default("")
  facebookUrl       String   @default("")
  tiktokUrl         String   @default("")
  pickupNote        String   @default("Retirada local mediante confirmação pelo atendimento.")
  shippingNote      String   @default("Enviamos para todo o Brasil com cotação por CEP. Algumas regiões podem exigir confirmação de cobertura, prazo, seguro ou taxa adicional pelo WhatsApp.")
  paymentNote       String   @default("Pix, cartão e pagamento com atendimento estão preparados para a fase de validação.")
  pixPaymentEnabled Boolean  @default(false)
  pixAccountType    String   @default("TEMPORARY_PERSONAL")
  pixRecipientName  String   @default("")
  pixRecipientDocument String @default("")
  pixKeyType        String   @default("RANDOM")
  pixKey            String   @default("")
  pixBankName       String   @default("")
  mercadoPagoMaxInstallments Int @default(6)
  priceAdjustmentDirection String @default("none")
  priceAdjustmentType      String @default("percent")
  priceAdjustmentValue     Int    @default(0)
  pixInstructions   String   @default("Finalize o pedido, faça o Pix e envie o comprovante pelo WhatsApp para confirmação do atendimento.")
  exchangeNote      String   @default("Trocas e devoluções seguem política própria antes da publicação oficial.")
  trustBadges       String[] @default(["Atendimento por WhatsApp", "Entrega para todo o Brasil", "Pedido mínimo sinalizado"])
  launchNote        String   @default("Ambiente em preparação: pedidos e pagamentos desta versão são simulados.")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
