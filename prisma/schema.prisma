generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  CANCELED
}

enum PaymentProvider {
  SIMULATED
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  SIMULATED
  PIX
  CREDIT_CARD
}

enum ShippingMethod {
  PADRAO
  EXPRESSA
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Brand {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String    @unique
  logo          String
  origin        String
  descriptionPt String
  featured      Boolean   @default(false)
  categorySlugs String[]
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  label     String
  note      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                  String      @id @default(cuid())
  slug                String      @unique
  brandId             String
  categoryId          String
  name                String
  subcategory         String
  priceCents          Int
  compareAtPriceCents Int?
  image               String
  gallery             String[]
  descriptionPt       String
  benefits            String[]
  ingredients         String[]
  skinType            String
  finish              String
  volume              String
  rating              Float
  reviewCount         Int
  stockStatus         String
  badges              String[]
  active              Boolean     @default(true)
  featuredRank        Int         @default(0)
  brand               Brand       @relation(fields: [brandId], references: [id])
  category            Category    @relation(fields: [categoryId], references: [id])
  inventory           Inventory?
  orderItems          OrderItem[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([categoryId, active])
  @@index([brandId, active])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  quantity  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

model Order {
  id                      String         @id @default(cuid())
  orderNumber             String         @unique
  status                  OrderStatus    @default(PENDING_PAYMENT)
  customerName            String
  customerEmail           String
  customerPhone           String
  customerCpf             String
  cep                     String
  state                   String
  city                    String
  district                String
  street                  String
  number                  String
  complement              String?
  addressMatchStatus      String         @default("NOT_CHECKED")
  addressMatchProvider    String?
  addressMatchFormatted   String?
  addressMatchPlaceId     String?
  addressMatchGranularity String?
  addressLatitude         Float?
  addressLongitude        Float?
  addressMatchMessage     String?
  addressMatchCheckedAt   DateTime?
  shippingMethod          ShippingMethod @default(PADRAO)
  subtotalCents           Int
  discountCents           Int
  shippingCents           Int
  totalCents              Int
  items                   OrderItem[]
  payment                 Payment?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([addressMatchStatus])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String?
  productSlug    String
  productName    String
  productBrand   String
  productImage   String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String          @unique
  provider    PaymentProvider @default(SIMULATED)
  method      PaymentMethod   @default(SIMULATED)
  status      PaymentStatus   @default(PENDING)
  amountCents Int
  paidAt      DateTime?
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model StoreProfile {
  id                    String   @id @default("main")
  storeName             String   @default("Bela Viva")
  legalName             String   @default("Bela Viva Comercio de Beleza Ltda.")
  cnpj                  String   @default("00.000.000/0000-00")
  stateRegistration     String   @default("Isento ou a ajustar")
  cep                   String   @default("00000-000")
  state                 String   @default("SP")
  city                  String   @default("Sao Paulo")
  district              String   @default("A ajustar")
  street                String   @default("Endereco em preparacao")
  number                String   @default("S/N")
  complement            String?
  email                 String   @default("contato@belaviva.local")
  whatsapp              String   @default("+55 11 90000-0000")
  businessHours         String   @default("Segunda a sexta, 9h as 18h")
  instagramUrl          String   @default("")
  facebookUrl           String   @default("")
  tiktokUrl             String   @default("")
  pickupNote            String   @default("Retirada local mediante confirmacao pelo atendimento.")
  shippingNote          String   @default("Transportadora, entrega padrao e excursao serao confirmadas antes do envio.")
  paymentNote           String   @default("Pix, cartao e pagamento simulado estao preparados para a fase de testes.")
  exchangeNote          String   @default("Trocas e devolucoes seguem politica propria antes da publicacao oficial.")
  trustBadges           String[] @default(["Loja em preparacao", "Atendimento por WhatsApp", "Pedido minimo sinalizado"])
  launchNote            String   @default("Ambiente em preparacao: pedidos e pagamentos desta versao sao simulados.")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
